/-! ## Z₆×Z₆ shift action on qubits

Qubit indexing: `q = sec*36 + i*6 + j` with `sec ∈ {0,1}`, `i,j ∈ Z₆`.
The shift action by `(da, db) ∈ Z₆ × Z₆` rotates `(i, j)` cyclically
within each sector. -/

/-- Shift qubit `q` by `(da, db) ∈ Z₆ × Z₆` (cyclic in `i, j`). -/
def shift_q (q : Fin 72) (da db : Fin 6) : Fin 72 :=
  let s := q.val / 36
  let i := (q.val % 36) / 6
  let j := q.val % 6
  let i' := (i + da.val) % 6
  let j' := (j + db.val) % 6
  ⟨s * 36 + i' * 6 + j', by
    have hs : s ≤ 1 := by
      simp only [s]; omega
    have hi : i' < 6 := Nat.mod_lt _ (by omega)
    have hj : j' < 6 := Nat.mod_lt _ (by omega)
    omega⟩

/-- Lift a shift to the action on `ErrorVec 72`: `(shift_E e da db) at q'
    equals `e q` where `q' = shift_q q da db`. We define it via inverse
    shift to keep dependent typing simple. -/
def shift_E (e : ErrorVec 72) (da db : Fin 6) : ErrorVec 72 :=
  fun q' =>
    -- Inverse shift: subtract (da, db) cyclically
    let s := q'.val / 36
    let i := (q'.val % 36) / 6
    let j := q'.val % 6
    let i₀ := (i + (6 - da.val) % 6) % 6
    let j₀ := (j + (6 - db.val) % 6) % 6
    let q : Fin 72 := ⟨s * 36 + i₀ * 6 + j₀, by
      have : s ≤ 1 := by simp only [s]; omega
      have : i₀ < 6 := Nat.mod_lt _ (by omega)
      have : j₀ < 6 := Nat.mod_lt _ (by omega)
      omega⟩
    e q

/-- **SE hook set is closed under Z₆×Z₆ shift.**
    Decidable, discharged by `native_decide` (180 hooks × 36 shifts =
    6,480 membership checks). -/
theorem bb_se_allHooks_shift_closed :
    ∀ e ∈ bb_se_allHooks, ∀ (da db : Fin 6),
      shift_E e da db ∈ bb_se_allHooks := by
  native_decide

/-! ## Structural shift-invariance lemmas (no `native_decide`) -/

/-- Shifting commutes with `ErrorVec.mul` (pointwise operation). -/
theorem shift_E_mul (a b : ErrorVec 72) (da db : Fin 6) :
    shift_E (ErrorVec.mul a b) da db =
      ErrorVec.mul (shift_E a da db) (shift_E b da db) := by
  funext q'
  rfl

/-- Shifting the identity is the identity. -/
theorem shift_E_identity (da db : Fin 6) :
    shift_E (ErrorVec.identity 72) da db = ErrorVec.identity 72 := by
  funext q'
  rfl

/-! ## Shift action as a `Fin 72` permutation (bijection) -/

/-- Negation in `Fin 6`: `neg_shift a = (6 - a) mod 6`. -/
def neg_shift (a : Fin 6) : Fin 6 := ⟨(6 - a.val) % 6, Nat.mod_lt _ (by omega)⟩

/-- Forward shift on qubits, derived from the inverse-shift used in `shift_E`. -/
def shift_q_fwd (q : Fin 72) (da db : Fin 6) : Fin 72 :=
  shift_q q (neg_shift da) (neg_shift db)

/-- `shift_q_fwd` is a left-inverse of `shift_q`: shifting forward then back is
    the identity on qubits. Verified by `native_decide` over 2,592 cases. -/
theorem shift_q_fwd_left_inv :
    ∀ (da db : Fin 6) (q : Fin 72),
      shift_q (shift_q_fwd q da db) da db = q := by
  native_decide

/-- `shift_q_fwd` is a right-inverse of `shift_q`: shifting back then forward is
    the identity on qubits. -/
theorem shift_q_fwd_right_inv :
    ∀ (da db : Fin 6) (q : Fin 72),
      shift_q_fwd (shift_q q da db) da db = q := by
  native_decide

/-- The Z₆×Z₆ shift action on qubits is a `Fin 72` permutation
    (Equiv) — combines the left- and right-inverse lemmas into a
    full bijection. This is the structural object that powers the
    orbit-reduction lemma (parity is invariant under simultaneous
    bijective substitution). -/
def shift_q_equiv (da db : Fin 6) : Fin 72 ≃ Fin 72 where
  toFun q := shift_q q da db
  invFun q := shift_q_fwd q da db
  left_inv q := shift_q_fwd_right_inv da db q
  right_inv q := shift_q_fwd_left_inv da db q

/-- `shift_E e` evaluated at `shift_q q` equals `e` at `q`. This is
    the fundamental defining property of the shift action. -/
theorem shift_E_apply_shift_q (e : ErrorVec 72) (da db : Fin 6) (q : Fin 72) :
    shift_E e da db (shift_q q da db) = e q := by
  have h : shift_E e da db (shift_q q da db) =
           e (shift_q_fwd (shift_q q da db) da db) := rfl
  rw [h]
  congr 1
  exact shift_q_fwd_right_inv da db q

/-- **Parity is invariant under simultaneous shift of both arguments.**
    A structural lemma: `parity` counts qubits where two ErrorVecs
    anticommute; under a qubit permutation (here `shift_q_equiv`) the
    cardinality is preserved.

    This is the key building block for `bb_se_isSuccess` shift-invariance
    and hence the orbit-reduction lemma. Discharged structurally, no
    `native_decide` over ErrorVec 72 needed. -/
theorem parity_shift_invariant (s e : ErrorVec 72) (da db : Fin 6) :
    ErrorVec.parity (shift_E s da db) (shift_E e da db) = ErrorVec.parity s e := by
  unfold ErrorVec.parity
  congr 1
  let σ : Fin 72 ≃ Fin 72 := shift_q_equiv da db
  -- LHS filter set = image of RHS filter set under σ
  have h_eq : (Finset.univ.filter fun i : Fin 72 =>
                 ErrorVec.Pauli.anticommutes (shift_E s da db i)
                                              (shift_E e da db i)) =
              (Finset.univ.filter fun j : Fin 72 =>
                 ErrorVec.Pauli.anticommutes (s j) (e j)).image σ := by
    ext i
    simp only [Finset.mem_filter, Finset.mem_univ, true_and, Finset.mem_image]
    constructor
    · intro h
      refine ⟨σ.symm i, ?_, σ.right_inv i⟩
      -- shift_E s da db i = s (σ.symm i) by definition; same for e.
      have hs : shift_E s da db i = s (σ.symm i) := rfl
      have he : shift_E e da db i = e (σ.symm i) := rfl
      rw [hs, he] at h
      exact h
    · rintro ⟨j, hj, rfl⟩
      have hs : shift_E s da db (σ j) = s j := shift_E_apply_shift_q s da db j
      have he : shift_E e da db (σ j) = e j := shift_E_apply_shift_q e da db j
      show ErrorVec.Pauli.anticommutes (shift_E s da db (σ j))
                                        (shift_E e da db (σ j))
      rw [hs, he]; exact hj
  rw [h_eq, Finset.card_image_of_injective _ σ.injective]

/-! ## Stab-parity shift-invariance

For any `E` and any shift `(da, db)`: "all 72 stab parities zero on
`shift_E E`" is equivalent to "all 72 stab parities zero on `E`".

Proof: combine `parity_shift_invariant` with `bb_stabilizers_shift_closed`
(which gives a bijection on stab indices under shift). -/

/-- The "inverse" direction of stab shift-closure: every stab is the
    shift-image of some other stab. Decidable by `native_decide`. -/
theorem bb_stabilizers_shift_closed_inv :
    ∀ (i : Fin 72) (da db : Fin 6),
      ∃ j : Fin 72, shift_E (bb_stabilizers j) da db = bb_stabilizers i := by
  native_decide

/-- **All stab parities zero is preserved under shift.** -/
theorem all_stab_parity_zero_shift_inv (E : ErrorVec 72) (da db : Fin 6) :
    (∀ i : Fin 72, ErrorVec.parity (bb_stabilizers i) E = false) →
    (∀ i : Fin 72, ErrorVec.parity (bb_stabilizers i) (shift_E E da db) = false) := by
  intro h_zero i
  -- Find j such that shift_E (stab j) = stab i.
  obtain ⟨j, hj⟩ := bb_stabilizers_shift_closed_inv i da db
  -- parity(stab i, shift_E E) = parity(shift_E (stab j), shift_E E) = parity(stab j, E) = false
  rw [← hj]
  rw [parity_shift_invariant]
  exact h_zero j

/-! ## Shift-equivariance of the stabiliser set

The X-stabs (and Z-stabs) of BB72 are invariant as a SET under
Z₆×Z₆ shift: shifting any stabiliser by (da, db) yields another
stabiliser in the same set. Decidable, discharged by `native_decide`. -/

/-- **Stabilisers are shift-closed.** For each stab `i` and shift `(da, db)`,
    there exists an index `j` such that `shift_E (bb_stabilizers i) da db
    = bb_stabilizers j`. Decidable: 72 stabs × 36 shifts × 72 candidate
    matches = ~187 k checks. -/
theorem bb_stabilizers_shift_closed :
    ∀ (i : Fin 72) (da db : Fin 6),
      ∃ j : Fin 72, shift_E (bb_stabilizers i) da db = bb_stabilizers j := by
  native_decide

/-! ## Shift-equivariance of L_Z cosets (the right statement)

The L_Z basis vectors are NOT exactly equal under shift (the
exact-equality version is `native_decide`-refuted). Instead, each
shifted L_Z basis vector decomposes as

    `shift_E (LZ_i) = (Σ_j M[i,j] · LZ_j) + (Z-stab combination)`

where `M : Fin 6 × Fin 6 → Matrix (Fin 12) (Fin 12) (Fin 2)` is the
"L_Z coset action" of the shift `(da, db)`.

**Empirically (Python, `notes/check_lz_parity_shift.py`)**: M is
**invertible over F₂ for all 36 shifts**. This is the structural fact
that powers the orbit-reduction lemma:

  * For X-only `E` with zero Z-syndrome (= our chain-XOR success
    candidates), `parity(LZ_j, shift_E E)` decomposes as
    `Σ_i M⁻¹[j,i] · parity(LZ_i, E)` (Z-stab combinations contribute 0
    parity to X-only errors when zero Z-syndrome).
  * Since `M⁻¹` is also invertible (over F₂), the predicate "∃ j,
    parity(LZ_j, _) = 1" is shift-invariant.
  * Combined with the X- and Z-stab shift-closure (above), this gives
    `bb_se_isSuccess (shift_E E da db) = bb_se_isSuccess E` for X-only
    `E` with zero Z-syndrome.

**Formalising in Lean** would require:
  1. Defining the 36 explicit `M` matrices (12×12 F₂, ~5k entries).
  2. Proving each is invertible via `native_decide` over precomputed
     determinants/inverses.
  3. Proving `parity(LZ_j, shift_E E) = Σ_i M⁻¹[j,i] · parity(LZ_i, E)`
     via Z-stab parity decomposition. This needs a parity-bilinearity
     lemma and the structural shift-equivariance of `parity` (proved
     below as `parity_shift_invariant`).

We provide the structural building block `parity_shift_invariant`;
the full L_Z coset orbit-reduction lemma is left as future work
(realistic, ~1 day of Lean engineering). -/

-- Note: the statement
--   ∀ i da db, ∃ j, shift_E (bb_logicalZ_basis i) da db = bb_logicalZ_basis j
-- is FALSE. Empirical Python verification shows the coset-level
-- statement (with invertible 12×12 F₂ action matrix) IS true.

/-! ## Mech indexing (used in both this file and `BB72SEChainCheck.lean`)

Each "X-mech" is either a Type-0 X at one of 72 qubits, or one of 180
SE hooks — total 252 mechs. -/

/-- Index `i : Fin 252`:
    * `i.val < 72`: Type-0 X mech at qubit `i.val`.
    * `i.val ≥ 72`: SE X-hook number `i.val - 72`. -/
def bb_se_xMech (i : Fin 252) : ErrorVec 72 :=
  if h : i.val < 72 then
    ErrorVec.update (ErrorVec.identity 72) ⟨i.val, by omega⟩ .X
  else
    bb_se_allHooks.getD (i.val - 72) (ErrorVec.identity 72)

