/-! ## SE backActionSet (sound over-approximation, same shape as NZ) -/

def bb_se_backActionSet (i : Fin 72) : Set (ErrorVec 72) :=
  if i.val < 36 then (fun e => e ∈ bb_se_allHooks)
  else (fun _ => False)

theorem bb_se_backActionSet_subset :
    ∀ (i : Fin 72) (e : ErrorVec 72),
      e ∈ bb_se_backActionSet i → e ∈ bb_se_allHooks := by
  intro i e he
  unfold bb_se_backActionSet at he
  by_cases h : i.val < 36
  · rw [if_pos h] at he; exact he
  · rw [if_neg h] at he; exact he.elim

/-- All SE hooks weight ≤ 5. -/
theorem bb_se_allHooks_weight_bound :
    ∀ e ∈ bb_se_allHooks, ErrorVec.weight e ≤ 5 := by
  native_decide

/-! ## QECParams instance for SE -/

def bb_se_code : QECParams where
  n := 72; k := 12; d := 6; R := 1
  numStab := 72
  stabilizers := bb_stabilizers
  backActionSet := bb_se_backActionSet
  r := 5
  backAction_weight_bound := by
    intro stab_idx e he
    have h_in : e ∈ bb_se_allHooks := bb_se_backActionSet_subset stab_idx e he
    exact bb_se_allHooks_weight_bound e h_in
  C_budget := 5
  hn := by omega
  hns := by omega
  hR := by omega

theorem bb_se_hooks_bound : hooksUpperBound bb_se_code bb_se_allHooks :=
  bb_se_backActionSet_subset

/-! ## Success predicate (same shape as NZ; uses BB72Instance's bb_logicalZ_basis). -/

def bb_se_isSuccess (E : ErrorVec 72) : Bool :=
  ((List.finRange 72).all fun i =>
    ErrorVec.parity (bb_stabilizers i) E = false) &&
  ((List.finRange 12).any fun i =>
    ErrorVec.parity (bb_logicalZ_basis i) E)

