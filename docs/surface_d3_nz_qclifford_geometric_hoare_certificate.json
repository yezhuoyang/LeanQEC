    },
    {
      "id": "A004",
      "rule": "G-RowSpread",
      "premises": ["A001"],
      "conclusion": "Centralizer(E) /\\ parity(LZ,E)=1 -> forall m. XRowsAll(ProdStab(m)*E)"
    },
    {
      "id": "A005",
      "rule": "G-ColSpread",
      "premises": ["A002"],
      "conclusion": "Centralizer(E) /\\ parity(LX,E)=1 -> forall m. ZColsAll(ProdStab(m)*E)"
    },
    {
      "id": "A006",
      "rule": "G-LogicalAnyToBarrierZero",
      "premises": ["A003", "A004", "A005"],
      "conclusion": "LogicalAny(E) -> (forall m. XRowsAll(ProdStab(m)*E)) \\/ (forall m. ZColsAll(ProdStab(m)*E))"
    },
    {
      "id": "A007",
      "rule": "G-DataDistance",
      "premises": ["A006"],
      "conclusion": "BI_PAIR -> (LogicalAny(data[]) -> 3 <= faults[])"
    },
    {
      "id": "A008",
      "rule": "G-FinalCircuitDistance",
      "premises": ["A007"],
      "conclusion": "FULL_INV -> (ZeroDet(det[]) /\\ LogicalAny(data[]) -> 3 <= faults[])"
    }
  ],
  "local_geometric_lemmas": [
