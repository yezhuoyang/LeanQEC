DERIVED BND[G2,7] := BI_PAIR(dataOf(PropDet(CX(q9,q4);CX(q9,q6);CX(q9,q7);H(q9);MeasZ(q9), phys[])), faults[])
DERIVED BND[G2,8] := BI_PAIR(dataOf(PropDet(CX(q9,q6);CX(q9,q7);H(q9);MeasZ(q9), phys[])), faults[])
DERIVED BND[G2,9] := BI_PAIR(dataOf(PropDet(CX(q9,q6);CX(q9,q7);H(q9);MeasZ(q9), phys[])), faults[])
