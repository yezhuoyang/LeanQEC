DERIVED BND[G4,1] := BI_PAIR(dataOf(PropDet(PrepP(q9);CX(q9,q0);CX(q9,q1);H(q9);MeasZ(q9), phys[])), faults[])
DERIVED BND[G4,2] := BI_PAIR(dataOf(PropDet(CX(q9,q0);CX(q9,q1);H(q9);MeasZ(q9), phys[])), faults[])
