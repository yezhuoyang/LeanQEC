DERIVED BND[G2,17] := BI_PAIR(dataOf(PropDet(MeasZ(q9), phys[])), faults[])

DERIVED BND[G3,1] := BI_PAIR(dataOf(PropDet(Prep0(q9);CX(q4,q9);CX(q7,q9);CX(q5,q9);CX(q8,q9);MeasZ(q9), phys[])), faults[])
DERIVED BND[G3,2] := BI_PAIR(dataOf(PropDet(CX(q4,q9);CX(q7,q9);CX(q5,q9);CX(q8,q9);MeasZ(q9), phys[])), faults[])
DERIVED BND[G3,3] := BI_PAIR(dataOf(PropDet(CX(q4,q9);CX(q7,q9);CX(q5,q9);CX(q8,q9);MeasZ(q9), phys[])), faults[])
DERIVED BND[G3,4] := BI_PAIR(dataOf(PropDet(CX(q4,q9);CX(q7,q9);CX(q5,q9);CX(q8,q9);MeasZ(q9), phys[])), faults[])
